{
  "expo": {
    "name": "Grimoire",
    "slug": "grimoire",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grimoire.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Grimoire a besoin d'accéder à votre appareil photo pour ajouter des photos.",
        "NSPhotoLibraryUsageDescription": "Grimoire a besoin d'accéder à votre galerie pour importer des photos.",
        "NSMicrophoneUsageDescription": "Grimoire a besoin du microphone pour la capture vidéo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.grimoire.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Grimoire a besoin d'accéder à votre galerie.",
          "cameraPermission": "Grimoire a besoin d'accéder à votre appareil photo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Grimoire a besoin d'accéder à votre appareil photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "grimoire",
    "updates": {
      "url": "https://u.expo.dev/79b7f855-ed52-42e3-b835-21e4dbcc75d4",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79b7f855-ed52-42e3-b835-21e4dbcc75d4"
      }
    },
    "owner": "leviatemps"
  }
}
